@namespace NFM.Components
@implements IDockGroupItem
@typeparam TPanel where TPanel : IPanel

@* Inactive panels stay mounted so their state (cameras, scroll positions) survives a tab switch. *@
<box style="display: @(Parent?.ActiveItem == this ? "contents" : "none")">
    <ComponentRenderer Type=@typeof(TPanel)/>
</box>

@code {
    [CascadingParameter]
    private DockGroup? Parent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public string Name => TPanel.Name;
    public bool IsTransparent => TPanel.IsTransparent;

    protected override void OnInitialized()
    {
        if (Parent is null)
            throw new ArgumentNullException(nameof(Parent), "DockGroupItem must exist within a DockGroup");

        Parent.AddItem(this);
        base.OnInitialized();
    }
}
