@namespace NFM.Components
@inherits Component
@inject IJSRuntime JS

<box class="row-container" @onpointerup=OnEndDrag @onpointermove=OnMouseMove @ref=rowContainerElement>
    @if (Left is not null)
    {
        <box @ref=leftContainerElement>
            @Left
            <div class="col-draghandle" @onpointerdown=@((e) => OnBeginDrag(e, DragOperation.Left)) />
        </box>
    }

    <box class="col-container">
        @if (Top is not null)
        {
            <box style="flex-direction: column" @ref=topContainerElement>
                @Top
                <div class="row-draghandle" @onpointerdown=@((e) => OnBeginDrag(e, DragOperation.Top)) />
            </box>
        }

        <box class="content-container">
            @Content
        </box>

        @if (Bottom is not null)
        {
            <box style="flex-direction: column" @ref=bottomContainerElement>
                <div class="row-draghandle" @onpointerdown=@((e) => OnBeginDrag(e, DragOperation.Bottom)) />
                @Bottom
            </box>
        }
    </box>

    @if (Right is not null)
    {
        <box @ref=rightContainerElement>
            <div class="col-draghandle" @onpointerdown=@((e) => OnBeginDrag(e, DragOperation.Right)) />
            @Right
        </box>
    }
</box>

@code {
    [Parameter]
    [EditorRequired]
    public required RenderFragment Content { get; set; }

    [Parameter]
    public RenderFragment? Left { get; set; }
    [Parameter]
    public RenderFragment? Right { get; set; }
    [Parameter]
    public RenderFragment? Top { get; set; }
    [Parameter]
    public RenderFragment? Bottom { get; set; }

    [CascadingParameter]
    public required DockManager.Layout Layout { get; set; }

    private ElementReference rowContainerElement;
    private ElementReference leftContainerElement;
    private ElementReference rightContainerElement;
    private ElementReference topContainerElement;
    private ElementReference bottomContainerElement;

    public DockPanel()
    {
        ShouldRenderOnEvent = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateStyles();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}
