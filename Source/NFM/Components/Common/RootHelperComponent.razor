@namespace NFM.Components
@inherits Component
@using NFM.Hosting
@typeparam TComponent where TComponent : IComponent
@inject IJSRuntime JS
@inject Form Form

@* Last stop for a drag that ended over something with no interest in it. *@
<box id="app-root-helper" style="width: 100%; height: 100%" @ref=boxElement
     @onpointermove=@(e => DragDrop.Update(e)) @onpointerup=@DragDrop.Clear>
    <ComponentRenderer Type=@(typeof(TComponent)) />
</box>

@code {
    ElementReference? boxElement = null;
    readonly DotNetObjectReference<RootHelperComponent<TComponent>> objectReference;

    public RootHelperComponent()
    {
        objectReference = DotNetObjectReference.Create(this);
    }

    protected override void OnDispose()
    {
        objectReference?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Form is IComponentForm componentForm)
        {
            // If needed, create a callback to update the form size alongside the content.
            if (componentForm.UseContentSize)
            {
                var child = await GetChildElement();
                await JS.InvokeVoidAsync("addResizeCallback", child, objectReference, "OnChildSizeChanged");
            }

            // Tell the form it's ready to appear.
            componentForm.Show();

            // Showing the window this late leaves focus on an arbitrary element.
            await JS.InvokeVoidAsync("blurActiveElement");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnChildSizeChanged()
    {
        if (Form is IComponentForm componentForm)
        {
            var child = await GetChildElement();
            var width = await JS.InvokeAsync<double>("HTMLElement.getClientWidth", child);
            var height = await JS.InvokeAsync<double>("HTMLElement.getClientHeight", child);

            componentForm.ClientWidth = (int)width;
            componentForm.ClientHeight = (int)height;
        }
    }

    Task<IJSObjectReference> GetChildElement() => JS.InvokeAsync<IJSObjectReference>("HTMLElement.getChild", boxElement, 0).AsTask();
}
