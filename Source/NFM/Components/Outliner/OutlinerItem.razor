@namespace NFM.Components
@inherits Component

<div class=@(Node.IsOwned ? "name owned" : "name")>
    @Node.Name
</div>

@code {
    [Parameter, EditorRequired]
    public required Node Node { get; set; }

    protected override int BuildHashCode()
    {
        return HashCode.Combine(Node.Name, Node.IsOwned);
    }
}
