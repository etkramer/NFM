@namespace NFM.Components
@inherits Component

<PageTitle>@Project.Name - NFM</PageTitle>

<box class="container">
    <MenuBar>
        <MenuItem Label="File">
            <MenuItem Label="New" OnPress=@OnPressNew/>
            <MenuItem Label="Open" OnPress=@OnPressOpen Hotkey=@(Keys.Control | Keys.O) />
            <MenuItem Label="Save" OnPress=@OnPressSave Hotkey=@(Keys.Control | Keys.S) />
            <MenuItem Label="Save as" OnPress=@OnPressSaveAs Hotkey=@(Keys.Control | Keys.Shift | Keys.S) />
            <MenuSeparator/>
            <MenuItem Label="Quit" OnPress=@Application.Exit/>
        </MenuItem>
        <MenuItem Label="Edit">
            <MenuItem Label="Copy" OnPress=@OnPressCopy Hotkey=@(Keys.Control | Keys.C) />
            <MenuItem Label="Paste" OnPress=@OnPressPaste Hotkey=@(Keys.Control | Keys.V) />
            <MenuSeparator/>
            <MenuItem Label="Delete" OnPress=@OnPressDelete Hotkey=@(Keys.Delete) />
        </MenuItem>
        <MenuItem Label="Window">
            @foreach (var panel in PanelRegistry.All.OrderBy(o => o.Name))
            {
                <MenuItem Label=@panel.Name OnPress=@(() => Guard.NotNull(dock).Open(panel.Type)) />
            }
        </MenuItem>
    </MenuBar>

    <box class="dock-container">
        <DockHost ConfigPath="Config/Layout.json" DefaultLayout=@BuildDefaultDockLayout @ref=dock />
    </box>
</box>

@code {
    DockHost? dock;

    protected override int BuildHashCode() => Project.Name.GetHashCode();

    void OnPressNew()
    {
        Project.Reset();
    }

    void OnPressSave()
    {
        if (Project.Path is null)
        {
            OnPressSaveAs();
            return;
        }

        Project.Save(Project.Path);
    }

    void OnPressSaveAs()
    {
        using (var fileDialog = new SaveFileDialog())
        {
            fileDialog.Filter = "JSON files (*.json)|*.json|All files (*.*)|*.*";
            fileDialog.RestoreDirectory = true;

            if (fileDialog.ShowDialog() is DialogResult.OK)
            {
                Project.Save(fileDialog.FileName);
            }
        }
    }

    void OnPressOpen()
    {
        using (var fileDialog = new OpenFileDialog())
        {
            fileDialog.Filter = "JSON files (*.json)|*.json|All files (*.*)|*.*";
            fileDialog.RestoreDirectory = true;

            if (fileDialog.ShowDialog() is DialogResult.OK)
            {
                _ = Project.LoadAsync(fileDialog.FileName);
            }
        }
    }

    void OnPressCopy()
    {
        Node[] nodes = Selection.Selected.OfType<Node>().Where(o => !o.IsOwned).ToArray();

        if (nodes.Length > 0)
        {
            Clipboard.SetText(NodeSerializer.Serialize(nodes));
        }
    }

    void OnPressPaste()
    {
        if (Clipboard.ContainsText())
        {
            _ = PasteAsync(Clipboard.GetText());
        }
    }

    // Pasted nodes can reference assets, which have to finish loading before saved bone state resolves.
    static async Task PasteAsync(string json)
    {
        List<Node> nodes = await NodeSerializer.Deserialize(json, null);

        if (nodes.Count > 0)
        {
            Selection.DeselectAll();
            Selection.Select(nodes);
        }
    }

    void OnPressDelete()
    {
        // Delete all selected nodes. Owned ones only go away with their owner.
        foreach (var node in Selection.Selected.OfType<Node>().Where(o => !o.IsOwned).ToArray())
        {
            node.Dispose();
        }
    }

    static DockLayout BuildDefaultDockLayout() => new(
        new DockSplit(DockOrientation.Horizontal,
            new DockSplit(DockOrientation.Vertical,
                new DockTabs(DockTab.Of<ViewportPanel>(), DockTab.Of<TimelinePanel>()),
                new DockTabs(DockTab.Of<LibraryPanel>()),
                ratio: 0.74),
            new DockSplit(DockOrientation.Vertical,
                new DockTabs(DockTab.Of<OutlinerPanel>()),
                new DockTabs(DockTab.Of<InspectorPanel>()),
                ratio: 0.26),
            ratio: 0.87));
}
