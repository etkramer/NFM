<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<OutputPath>$(RuntimeDir)Binaries\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- Avalonia 12 defaults to compiled bindings, which need x:DataType on every view -->
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>
    
	<ItemGroup>
	  <AdditionalFiles Include="NativeMethods.txt" />
	  <AvaloniaResource Include="Assets\appicon.ico" />
	  <AvaloniaResource Include="Assets\Fonts\MaterialIcons-Regular.ttf" />
	  <AvaloniaResource Include="Assets\Fonts\MaterialIconsOutlined-Regular.otf" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NFM.Engine\NFM.Engine.csproj" />
		<ProjectReference Include="..\Modules\NFM.Generators\NFM.Generators.csproj" OutputItemType="Analyzer" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
		<PackageReference Include="ReactiveUI.Avalonia.Reactive" Version="12.1.1" />
		<PackageReference Include="DynamicData" Version="9.4.33" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
</Project>