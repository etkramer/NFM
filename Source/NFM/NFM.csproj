<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<AssemblyName>NFM</AssemblyName>
		<RootNamespace>NFM</RootNamespace>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- The WebView2 package offers a WPF control we don't use, whose WindowsBase pulls in a conflict. -->
		<UseWpf>false</UseWpf>
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationIcon>wwwroot\appicon.ico</ApplicationIcon>
		<OutputPath>$(RuntimeDir)Binaries\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="NativeMethods.txt" />
	</ItemGroup>

	<!--
		Blazor resolves everything under the app base through a plain file provider over wwwroot, so the
		scoped CSS bundle and the framework's own assets have to actually be there.
	-->
	<Target Name="CopyStaticWebAssetsToOutput" AfterTargets="Build" DependsOnTargets="ResolveStaticWebAssetsInputs">
		<ComputeStaticWebAssetsTargetPaths Assets="@(StaticWebAsset)" PathPrefix="wwwroot" UseAlternatePathDirectorySeparator="true">
			<Output TaskParameter="AssetsWithTargetPath" ItemName="_OutputWebAsset" />
		</ComputeStaticWebAssetsTargetPaths>

		<Copy SourceFiles="@(_OutputWebAsset)" DestinationFiles="@(_OutputWebAsset->'$(OutDir)%(TargetPath)')" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\NFM.Engine\NFM.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="8.0.100" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
</Project>
