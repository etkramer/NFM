@namespace NFM.Panels
@inherits Component
@implements IPanel
@inject IJSRuntime JS
@using NFM.Graphics
@using NFM.Hosting

<box class="container">
    <div class="viewport" @ref=element />

    <box class="statusbar">
        @* Focus holds the menu open - its entries aren't focusable, so clicking one keeps it here. *@
        <box class="mode-picker" tabindex="0" @onfocusout=@(() => isModeOpen = false)>
            <div class="mode-button btn-soft" @onclick=@(() => isModeOpen = !isModeOpen)>
                <span>@GetLabel(CurrentMode)</span>
                <FontIcon Glyph="arrow_drop_down" FontSize="16" />
            </div>
            @if (isModeOpen)
            {
                <box class="mode-menu">
                    @foreach (DisplayMode mode in Modes)
                    {
                        <div class="btn-soft" @onclick=@(() => SetMode(mode))>@GetLabel(mode)</div>
                    }
                </box>
            }
        </box>

        <span>@memoryDisplay</span>
        <span>@frameTimeDisplay</span>
    </box>
</box>

@code {
    public static string Name => "Viewport";

    // The 3D is composited underneath the page, so nothing here may paint over it.
    public static bool IsTransparent => true;

    static int nextId;

    readonly int id = ++nextId;
    ElementReference element;

    string frameTimeDisplay = string.Empty;
    string memoryDisplay = string.Empty;

    long lastFrameTimeUpdate;
    long lastMemoryUpdate;

    double frameTimeTotal;
    int frameTimeCount;

    static readonly DisplayMode[] Modes = Enum.GetValues<DisplayMode>();

    bool isModeOpen;

    // The host is created asynchronously once the page reports our rect, so it can't be cached at construction.
    CameraNode? Camera => Viewport.All.FirstOrDefault(o => o.HostControl is ViewportHost host && host.Id == id)?.Camera;

    DisplayMode CurrentMode => Camera?.DisplayMode ?? DisplayMode.Unlit;

    public ViewportPanel()
    {
        ShouldRenderOnEvent = true;
    }

    void SetMode(DisplayMode mode)
    {
        isModeOpen = false;

        if (Camera is CameraNode camera)
        {
            camera.DisplayMode = mode;
        }
    }

    static string GetLabel(DisplayMode mode) => mode switch
    {
        DisplayMode.Unlit => "Unlit",
        DisplayMode.DebugNormals => "Debug Normals",
        DisplayMode.DebugMetallic => "Debug Metallic",
        DisplayMode.DebugSpecular => "Debug Specular",
        DisplayMode.DebugRoughness => "Debug Roughness",
        _ => mode.ToString(),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("registerViewport", element, id);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void OnDispose()
    {
        _ = JS.InvokeVoidAsync("unregisterViewport", id);
    }

    protected override void OnTick()
    {
        long now = Environment.TickCount64;

        // A single frame's time is far too noisy to read, so show the mean over the display interval.
        frameTimeTotal += Metrics.FrameTime;
        frameTimeCount++;

        if (now - lastFrameTimeUpdate >= 500)
        {
            lastFrameTimeUpdate = now;
            frameTimeDisplay = $"Frametime: {frameTimeTotal / frameTimeCount * 1000:0.00}ms";

            frameTimeTotal = 0;
            frameTimeCount = 0;
        }

        if (now - lastMemoryUpdate >= 1000)
        {
            lastMemoryUpdate = now;
            memoryDisplay = $"Memory: {Environment.WorkingSet / 1024 / 1024}MB";
        }
    }

    protected override int BuildHashCode() => HashCode.Combine(frameTimeDisplay, memoryDisplay, isModeOpen, CurrentMode);
}
